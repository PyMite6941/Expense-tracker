# Copy to .env and fill in values before deploying.
# This file is a COMMITTED TEMPLATE in a PUBLIC repo — never put real values in it.

# ── Required ─────────────────────────────────────────────────────────────────

# HS256 verification secret. MUST be byte-identical to auth-service's JWT_SECRET
# (auth-service signs, this service verifies). The service REFUSES TO START if
# this is unset, under 32 chars, or a known placeholder.
JWT_SECRET=

# ── AI providers ─────────────────────────────────────────────────────────────
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ── GCP ──────────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=
# Path to a service-account JSON for the Vision OCR API. On Cloud Run leave this
# unset and let the default compute service account provide credentials.
GOOGLE_APPLICATION_CREDENTIALS=

# ── Admin ────────────────────────────────────────────────────────────────────
# Shared secret for POST /admin/reset-activations (X-Admin-Secret header).
# Unset = the endpoint is disabled (503).
ADMIN_RESET_SECRET=

# ── Activation / rate limiting ───────────────────────────────────────────────
# Trusted proxies IN FRONT OF Cloud Run. 0 is correct for a *.run.app URL hit
# directly. Setting it too HIGH lets callers spoof their IP, evade rate limits,
# and share one license across unlimited devices.
TRUSTED_PROXY_HOPS=0

IP_LIMIT_COLLECTION=license_ips
# true (default) = allow requests through if Firestore is unreachable.
IP_LIMIT_FAIL_OPEN=true

# LOCAL DEVELOPMENT ONLY — never set on a deployed service.
# ALLOW_INSECURE_JWT_SECRET=1

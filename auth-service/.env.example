# Copy to .env and fill in values before deploying.
# This file is a COMMITTED TEMPLATE in a PUBLIC repo — never put real values in it.

# ── Required ─────────────────────────────────────────────────────────────────

# HS256 signing secret. auth-service signs license JWTs with it and backend/
# verifies them, so BOTH services must carry the identical value.
# Both now REFUSE TO START if this is unset, shorter than 32 chars, or left as a
# placeholder — a silent fallback would have meant licenses anyone could forge.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Required by POST /issue (the trusted/manual mint path used by gen_code.py and
# the store webhook). If this is unset, /issue returns 503 and refuses to mint —
# it used to fall through and issue licenses to anyone who asked.
ISSUE_SECRET=

# ── Email delivery (best-effort; issuance still succeeds if it fails) ─────────

# "resend" (default) or "smtp"
EMAIL_PROVIDER=resend

# Resend API key, used when EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=GRID <licenses@resend.dev>

# Gmail app password (Settings → Security → App passwords), used when
# EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Optional ─────────────────────────────────────────────────────────────────

# Comma-separated CORS origins allowed to call this service.
ALLOWED_ORIGINS=

# Number of trusted proxies IN FRONT OF Cloud Run. 0 (the default) is correct
# for a *.run.app URL hit directly. Raise it only if you put a custom external
# HTTPS load balancer or Cloudflare in front — each extra hop shifts the real
# client one position left in X-Forwarded-For. Setting this too HIGH lets
# callers spoof their own IP and evade rate limits.
TRUSTED_PROXY_HOPS=0

# LOCAL DEVELOPMENT ONLY. Lets the service boot with a missing/weak JWT_SECRET.
# Never set this on a deployed service.
# ALLOW_INSECURE_JWT_SECRET=1

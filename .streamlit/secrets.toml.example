# Streamlit secrets for the hosted app (streamlit_app.py).
#
# On Streamlit Community Cloud paste the parts you need into
#   App → ⋮ → Settings → Secrets
# Locally, copy this file to .streamlit/secrets.toml (gitignored).
#
# NOTHING here is required. With no secrets at all the hosted app runs in
# "session" mode: the full app, each visitor's data private to their browser
# session, paid features calling the Vercel services below.
#
# Never put JWT_SECRET, ISSUE_SECRET, ADMIN_RESET_SECRET or an AI key here.
# Those belong ONLY on the Vercel services. The app verifies licences by
# calling the auth service, so it never needs the signing secret.

# ── Where the paid features are served (defaults shown) ─────────────────────
# BACKEND_URL      = "https://finance-kit-backend.vercel.app"
# AUTH_SERVICE_URL = "https://finance-kit-auth.vercel.app"

# ── Storage ─────────────────────────────────────────────────────────────────
# "session" (default for streamlit_app.py) | "hosted" (Neon, needs the two below)
# STORAGE_MODE = "session"

# Hosted mode only: the Neon Postgres connection string.
# ET_DATABASE_URL = "postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Hosted mode only: sign-in through st.login() (any OIDC provider).
# [auth]
# redirect_uri = "https://YOUR-APP.streamlit.app/oauth2callback"
# cookie_secret = "a long random string"
# client_id = "..."
# client_secret = "..."
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# ── Paywall links (defaults shown) ──────────────────────────────────────────
# GRID_STORE_URL   = "https://grid-store.pages.dev"
# GRID_LICENSE_URL = "https://grid-store.pages.dev/projects"
